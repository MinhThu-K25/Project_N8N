        "jsCode": "return items.map(item => {\n  // Lấy nội dung text\n  let text = item.json.text || \"\";\n  const image = $('Get row(s) in sheet').first().json['Tên'] ;\n  // Dòng này xóa tất cả dấu * hoặc **\n  text = text.replace(/\\*/g, \"\");\n\n  // Ghi lại kết quả vào output\n  item.json.context = text;\n  item.json.promt_image = image;\n\n  return item;\n});"
