      "parameters": {
        "jsCode": "// ✅ Trường hợp KHÔNG tìm thấy sản phẩm hợp lệ\nreturn [{\n    json: {\n        error: true, // Biến đánh dấu có lỗi xảy ra\n        errorCode: \"ERR_NO_VALID_PRODUCTS\", // Mã lỗi cụ thể\n        errorMessage: \"Không tìm thấy sản phẩm hợp lệ nào\" // Thông báo lỗi cho người dùng\n    }\n}]\n\n// ✅ Nếu đến được đoạn code này nghĩa là dữ liệu hợp lệ\nconsole.log(\"Hoàn thành. Các sản phẩm hợp lệ:\", JSON.stringify(requestedItems));\n// In ra console danh sách sản phẩm hợp lệ để kiểm tra hoặc debug\n\n// ✅ Trả về kết quả khi mọi thứ đều hợp lệ\nreturn [{\n    json: {\n        requestedItems: requestedItems, // Danh sách sản phẩm đã được xác nhận là hợp lệ\n        customerEmail: customerEmail,   // Email của khách hàng\n        chatId: chatId,                 // ID của cuộc trò chuyện (nếu có)\n        errorCode: \"NONE\"               // Không có lỗi\n    }\n}]"
      },
